{
  "name": "@chaeco/auto-router",
  "version": "0.2.2",
  "description": "File-based automatic router plugin for Node.js frameworks (Hoa, Express, Koa, Fastify, etc.)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker-manifest": {
      "import": "./dist/worker-manifest.js",
      "types": "./dist/worker-manifest.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    ".claude/skills/auto-router",
    ".codex/skills/auto-router",
    "scripts/init-skills.js",
    "CHANGELOG.md",
    "README.md",
    "README-zh.md"
  ],
  "bin": {
    "auto-router-init-skills": "scripts/init-skills.js",
    "auto-router-build-manifest": "dist/build-worker-manifest.js"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs && node scripts/restore-shebang.mjs",
    "build:docs": "node scripts/inject-version.js",
    "dev": "rollup -c rollup.config.mjs -w",
    "prepack": "npm run build && npm run build:docs",
    "version:bump": "node scripts/bump-version.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "hoa",
    "express",
    "koa",
    "fastify",
    "router",
    "auto-router",
    "file-based",
    "plugin"
  ],
  "author": "iptodays",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaeco/auto-router.git"
  },
  "homepage": "https://github.com/chaeco/auto-router#readme",
  "bugs": {
    "url": "https://github.com/chaeco/auto-router/issues"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0"
  }
}
